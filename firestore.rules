rules_version = '2';

// Reglas de seguridad para Cloud Firestore - El Ropero
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identificación estricta del Admin por Custom Claim o email autorizado
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'manager' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@elropero.*')) ||
        request.auth.token.email == 'elropero.informacion@gmail.com' ||
        request.auth.token.email == 'yazminetchanchu@gmail.com'
      );
    }

    // Una escritura no puede vaciar ni achicar de golpe una lista contable del showroom.
    // Permite quitar como máximo 1 elemento por escritura (borrar una venta/egreso) y
    // exige que el campo no desaparezca si ya existía (evita setDoc que pisa todo el doc).
    function keepsList(field) {
      return !(field in resource.data)
        || (field in request.resource.data
            && request.resource.data[field].size() >= resource.data[field].size() - 1);
    }

    // Reglas para el documento principal del showroom e inventario (Solo Admin)
    match /showrooms/{showroomId} {
      // Restringir lectura del documento monolítico exclusivamente a administradores
      // Protege ventas históricas, egresos, costos mayoristas y tarjetas de regalo globales
      allow read: if isAdmin();
      
      // Crear solo Admin. El documento del showroom NO se puede borrar desde clientes.
      allow create: if isAdmin();
      allow delete: if false;
      
      // Solo administradores pueden actualizar el showroom directamente, y sin achicar
      // ventas (buffer), egresos ni cierres mensuales ni quitar webSettings.
      // Clientes y operaciones de checkout deben usar Cloud Functions seguras.
      allow update: if isAdmin()
        && keepsList('sales')
        && keepsList('expenses')
        && keepsList('closures')
        && (!('webSettings' in resource.data) || 'webSettings' in request.resource.data);

      // Subcolección de pedidos web directos (/webOrders) - Solo Admin
      match /webOrders/{orderId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }

      // Subcolección de clientes protegida
      match /customers/{customerId}/{document=**} {
        allow read, write: if isAdmin() || (isAuthenticated() && request.auth.uid == customerId);
      }

      // Subcolección de órdenes del showroom (web orders)
      match /orders/{orderId} {
        // 'get' público para que el invitado consulte su comprobante por ID puntual
        // 'list' restringido exclusivamente al administrador
        allow get: if true;
        allow list: if isAdmin();

        // Creación permitida para registrar pedidos de checkout
        allow create: if true;

        // Modificación y borrado estrictamente restringidos a Administradores
        allow update, delete: if isAdmin();
      }

      // Cambios pendientes de confirmación (antes cubierto por el comodín final)
      match /pending_cambios/{cambioId} {
        allow read, write: if isAdmin();
      }

      // Subcolección de ventas del showroom (evita límite de 1 MB en doc showroom)
      match /sales/{saleId} {
        allow read, write: if isAdmin();
      }

      // Gift Cards del showroom: solo admin. Evita FirebaseError de permisos
      // si un cliente lista esta colección desde el dashboard.
      match /giftCards/{cardId} {
        allow read, write: if isAdmin();
      }
    }

    // Colección root de clientes y subcolecciones privadas (orders, giftCards)
    match /customers/{customerId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == customerId || isAdmin());
      match /{document=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == customerId || isAdmin());
      }
    }

    // Colecciones independientes explícitas para Gift Cards y Ventas
    match /gift_cards/{cardId} {
      allow read: if true; // Requerido para verificación por código en Checkout
      allow write: if isAdmin();
    }

    match /giftCards/{cardId} {
      allow read, write: if isAdmin();
    }

    match /sales/{saleId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Productos: Lectura pública para la tienda online, escritura solo Admin
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // AUDIT LOGS: Nadie (ni siquiera el Admin) puede modificar o borrar logs creados
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Inmutabilidad absoluta
    }

    // Cola de emails (extensión Trigger Email from Firestore)
    // Permite encolar un correo si incluye los campos esenciales (to y message)
    match /mail/{mailId} {
      allow create: if request.resource.data.to != null && request.resource.data.message != null;
      allow read, update, delete: if isAdmin();
    }

    // Resto de rutas no explícitas: solo lectura para Admin.
    // IMPORTANTE: este comodín NO concede escritura. Las reglas de Firestore se suman (OR);
    // un `write` acá anularía las restricciones de /showrooms/{showroomId} (anti-borrado).
    match /{document=**} {
      allow read: if isAdmin();
    }
  }
}

