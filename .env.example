# Configuración Firebase (Frontend)
VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_messaging_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
VITE_FIREBASE_MEASUREMENT_ID=tu_measurement_id

# Configuración Ualá Bis (Plantilla Frontend)
VITE_UALA_ENV=production
VITE_UALA_CLIENT_ID=tu_client_id_aqui
VITE_UALA_RETURN_URL=https://elropero.ar/uala-return
VITE_UALA_USERNAME=tu_usuario_aqui
VITE_UALA_CLIENT_ID_STAGE=uapi_checkout_user
VITE_UALA_CHECKOUT_URL_STAGE=https://checkout.stage.developers.ar.ua.la/v2/api/checkout
VITE_UALA_AUTH_URL_STAGE=https://auth.stage.developers.ar.ua.la/v2/api/auth/token
VITE_UALA_API_URL=https://checkout.stage.developers.ar.ua.la/v2/api
VITE_UALA_USERNAME_STAGE=uapi_checkout_user

# Credenciales PAQ.AR
VITE_PAQAR_CLIENT_ID=
VITE_PAQAR_CLIENT_SECRET=
VITE_PAQAR_CONTRATO=
VITE_PAQAR_CUENTA=
VITE_PAQAR_BASE_URL="https://api.correoargentino.com.ar/paqar"

VITE_UALA_WEBHOOK_URL=https://us-central1-el-ropero-8989a.cloudfunctions.net/ualaWebhook

# Variables opcionales para scripts de administración (scripts/createAdminUser.js)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=tu_clave_segura_aqui

# Variables para pruebas de Correo Argentino (test_micorreo.js)
MICORREO_USERNAME=tu_usuario_micorreo
MICORREO_PASSWORD=tu_password_micorreo
MICORREO_CUSTOMER_ID=tu_customer_id

